# Copy to `.env` for docker compose (never commit real keys).
# GEMINI_API_KEY is optional: only needed for `--layout-planner gemini`
# or generative-gemini inpaint. It is never baked into Docker images.

# GEMINI_API_KEY=
# GOOGLE_API_KEY=
# OPENAI_API_KEY=

# PDF2PPT_LAYOUT_PLANNER_MODEL=
# PDF2PPT_GEMINI_IMAGE_MODEL=
# PDF2PPT_OPENAI_IMAGE_MODEL=

# PDF2PPT_API_PORT=8008
# PDF2PPT_UI_PORT=8080
# PDF2PPT_JOB_RETENTION_HOURS=24
# PDF2PPT_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# Do not set PDF2PPT_CORS_ORIGINS=* (credentials are enabled).
# Comma-only values fall back to the Vite localhost defaults.

# OCR model cache mounts at /data/model. Default is the named volume
# `pdf2ppt-models` (writable by container uid 10001). To use a host path:
#   mkdir -p model && sudo chown 10001:10001 model
#   PDF2PPT_MODEL_DIR=./model
# PDF2PPT_MODEL_DIR=pdf2ppt-models

# Rebuild API with LibreOffice for --refine / slide-quality:
# INSTALL_LIBREOFFICE=1
