# Copy to `.env` for docker compose (never commit real keys).
# GEMINI_API_KEY is optional: only needed for `--layout-planner gemini`
# or generative-gemini inpaint. It is never baked into Docker images.

# GEMINI_API_KEY=
# GOOGLE_API_KEY=
# OPENAI_API_KEY=

# PDF2PPT_LAYOUT_PLANNER_MODEL=
# PDF2PPT_GEMINI_IMAGE_MODEL=
# PDF2PPT_OPENAI_IMAGE_MODEL=

# PDF2PPT_API_PORT=8008
# PDF2PPT_UI_PORT=8080
# PDF2PPT_JOB_RETENTION_HOURS=24
# PDF2PPT_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# Do not set PDF2PPT_CORS_ORIGINS=* (credentials are enabled).
# Comma-only values fall back to the Vite localhost defaults.

# --- pip / CLI only unless added to docker-compose.yml ---
# docker-compose.yml forwards only the variables listed under api.environment.
# The settings below (page timeout, zip limits, planner USD rates, …) apply to
# pip/CLI runs. They are NOT passed into the Compose API container unless you
# add them under api.environment yourself.

# Per-page OCR/layout timeout (seconds). CLI --page-timeout-s overrides.
# <=0 disables. Default 120.
# PDF2PPT_PAGE_TIMEOUT_S=120

# Safe limits for from-ir assets_zip (defaults shown).
# PDF2PPT_ZIP_MAX_COMPRESSED_BYTES=52428800
# PDF2PPT_ZIP_MAX_UNCOMPRESSED_BYTES=209715200
# PDF2PPT_ZIP_MAX_ENTRIES=10000
# PDF2PPT_ZIP_MAX_ENTRY_BYTES=52428800
# PDF2PPT_ZIP_MAX_COMPRESSION_RATIO=100

# Planner cost accounting (defaults shown).
# PDF2PPT_LAYOUT_PLANNER_INPUT_USD_PER_MTOK=0.25
# PDF2PPT_LAYOUT_PLANNER_OUTPUT_USD_PER_MTOK=1.50


# OCR model cache mounts at /data/model. Default is the named volume
# `pdf2ppt-models` (writable by container uid 10001). To use a host path:
#   mkdir -p model && sudo chown 10001:10001 model
#   PDF2PPT_MODEL_DIR=./model
# PDF2PPT_MODEL_DIR=pdf2ppt-models

# Rebuild API with LibreOffice for --refine / slide-quality:
# INSTALL_LIBREOFFICE=1
